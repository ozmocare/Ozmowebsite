# Copy to .env.local for local development, and add the same two values in
# Vercel → Project → Settings → Environment Variables.
# Find them in Supabase → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Google Sheet lead tracking (see google-sheets/README.md). Server-only — no NEXT_PUBLIC_ prefix.
GOOGLE_SHEETS_WEBHOOK_URL=
GOOGLE_SHEETS_SECRET=

# Google Ads conversion tracking (Google Ads → Goals → Conversions → your "Lead form" action → Tag setup)
NEXT_PUBLIC_GOOGLE_ADS_ID=
NEXT_PUBLIC_GOOGLE_ADS_CONVERSION_LABEL=
